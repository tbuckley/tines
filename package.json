{
	"name": "tines-monorepo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @tines/web dev",
		"build": "pnpm -r build",
		"check": "pnpm check:migrations && pnpm check:scripts && pnpm -r check",
		"check:migrations": "node apps/web/scripts/check-migrations.mjs",
		"check:scripts": "node scripts/check-package-scripts.mjs",
		"format": "prettier --write . --cache",
		"format:check": "prettier --check . --cache",
		"test": "node --test scripts/release-version.test.mjs && pnpm -r test",
		"test:e2e": "pnpm --filter @tines/web test:e2e",
		"db:migrate:local": "pnpm --filter @tines/web db:migrate:local",
		"db:seed:local": "pnpm --filter @tines/web db:seed:local",
		"cli": "pnpm --filter tines start"
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=20"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd",
			"sharp"
		]
	},
	"devDependencies": {
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1"
	}
}
