{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tines-web",
	"compatibility_date": "2025-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			// Production custom domain. Requires the tbuckley.com zone on this
			// Cloudflare account; `wrangler deploy` creates the DNS record and cert.
			"pattern": "tines.tbuckley.com",
			"custom_domain": true
		}
	],
	// No production traffic on tines-web.<subdomain>.workers.dev —
	// production is served only at tines.tbuckley.com...
	"workers_dev": false,
	// ...but keep per-version preview URLs on workers.dev
	// (used by the PR preview workflow, .github/workflows/preview.yml).
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tines",
			// Replace with the real id from `wrangler d1 create tines` before deploying.
			// The placeholder is fine for local dev (`pnpm dev` / `wrangler dev`).
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"send_email": [
		{
			// Cloudflare Email Service binding for magic-link sign-in emails.
			// Under `wrangler dev` sends are simulated (logged locally, nothing
			// delivered); add `"remote": true` here to send real emails from dev.
			"name": "EMAIL"
		}
	],
	"vars": {
		// Public, non-secret vars. Secrets (BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID,
		// GOOGLE_CLIENT_SECRET) go in `.dev.vars` locally and `wrangler secret put` in prod.
		// Local dev overrides this via .dev.vars (BETTER_AUTH_URL=http://localhost:5173).
		"BETTER_AUTH_URL": "https://tines.tbuckley.com",
		// Sender for magic-link emails. Must be an address on a domain onboarded to
		// Email Service (Cloudflare dash → Compute → Email Service → Email Sending).
		"EMAIL_FROM": "tines-noreply@tbuckley.com"
	},
	"env": {
		// PR previews (.github/workflows/preview.yml): a separate worker
		// ("tines-web-preview") with its own D1 database, so previews never touch
		// production data and PR migrations can be tried out safely. The preview
		// DB is disposable — see "PR preview URLs" in the README to reset it.
		// Non-inheritable keys (d1_databases, send_email, vars) must be restated here.
		"preview": {
			"workers_dev": false,
			"preview_urls": true,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "tines-preview",
					// Replace with the real id from `wrangler d1 create tines-preview`.
					"database_id": "00000000-0000-0000-0000-000000000000",
					"migrations_dir": "migrations"
				}
			],
			"send_email": [{ "name": "EMAIL" }],
			"vars": {
				// BETTER_AUTH_URL is deliberately unset: preview URLs differ per
				// version, so auth derives its base URL from the request origin
				// (see src/lib/server/auth.ts). Magic-link sign-in works on
				// previews; Google OAuth does not (no wildcard redirect URIs).
				"EMAIL_FROM": "tines-noreply@tbuckley.com"
			}
		}
	}
}
