{
	"name": "@tines/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "pnpm run build && wrangler dev --host localhost:8787 --test-scheduled",
		"deploy:prod": "pnpm run build && wrangler deploy",
		"db:migrate:local": "wrangler d1 migrations apply tines --local",
		"db:migrate:remote": "wrangler d1 migrations apply tines --remote",
		"db:seed:local": "node scripts/seed-dev.mjs",
		"cf-typegen": "wrangler types",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"perf:nav": "rm -f /tmp/navperf.txt && NAVPERF=1 vitest run src/lib/server/api/nav-perf.test.ts && cat /tmp/navperf.txt",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260822.1",
		"@internationalized/date": "^3.12.3",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"bits-ui": "^2.19.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11",
		"wrangler": "^4.125.0"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.121.0",
		"@tabler/icons-svelte": "^3.46.0",
		"@tines/shared": "workspace:*",
		"better-auth": "^1.7.1",
		"clsx": "^2.1.1",
		"kysely": "^0.29.5",
		"kysely-d1": "^0.4.0",
		"micromark": "^4.0.2",
		"micromark-extension-gfm": "^3.0.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	}
}
