{
	"name": "tines",
	"version": "0.0.1",
	"description": "CLI for Tines, an orchestration layer for AI agents",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tbuckley/tines.git",
		"directory": "packages/cli"
	},
	"license": "UNLICENSED",
	"type": "module",
	"bin": {
		"tines": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --banner:js=\"#!/usr/bin/env node\" --outfile=dist/index.js",
		"start": "TINES_API_URL=${TINES_API_URL:-http://localhost:5173} tsx src/index.ts",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm run build"
	},
	"devDependencies": {
		"@tines/shared": "workspace:*",
		"@types/node": "^26.2.0",
		"commander": "^15.0.0",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
