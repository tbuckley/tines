{
	"name": "@tines/cli",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"bin": {
		"tines": "./dist/index.js"
	},
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --external:commander --banner:js=\"#!/usr/bin/env node\" --outfile=dist/index.js",
		"start": "tsx src/index.ts",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@tines/shared": "workspace:*",
		"commander": "^15.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
