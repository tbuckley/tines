// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`help output > matches the recorded help text for every command 1`] = `
{
  "tines": "Usage: tines [options] [command]

CLI for Tines

Options:
  -V, --version     output the version number
  -h, --help        display help for command

Commands:
  time [options]    Fetch the current time from the Tines API
  login [options]   Store the API URL and key for this machine, so commands need
                    no env vars
  logout            Forget the stored API URL and key
  config [options]  Show the API URL and key in effect, and where each comes
                    from
  projects          Manage projects
  workflows         Manage the workflow library
  issues            Work with issues
  labels            Manage the label library
  context           Manage context items (prompts, skills, repo pointers) scoped
                    to projects, states, and issues
  journal           An issue's stage journal: shared notes for its project + the
                    stage your run was launched in
  schedules         Manage scheduled tasks (addressed as <project>/<name>)
  runners           Manage the runner registry
  runner            The local runner daemon
  runs              Agent runs: attempts at issues by runners
  routing           Scoped routing rules: which runner takes which issues (most
                    specific scope wins)
  supervisor        The automation kill switch, quota policy, and attempt limit
  events            Read the activity log
  help [command]    display help for command
",
  "tines config": "Usage: tines config [options]

Show the API URL and key in effect, and where each comes from

Options:
  -u, --url <url>  base URL of the Tines API (or set TINES_API_URL, or run
                   \`tines login\`; default https://tines.tbuckley.dev)
  --api-key <key>  API key (or set TINES_API_KEY, or run \`tines login\`)
  --json           output the raw JSON response
  -h, --help       display help for command
",
  "tines context": "Usage: tines context [options] [command]

Manage context items (prompts, skills, repo pointers) scoped to projects,
states, and issues

Options:
  -h, --help             display help for command

Commands:
  list [options]         List context items (scope filters match every item
                         whose scope includes the element)
  show [options] <id>    Show a context item (skills include their files)
  create [options]       Create a context item scoped to a project, state,
                         and/or issue
  edit [options] <id>    Edit a context item: payload, name, description, or
                         scope
  delete [options] <id>  Delete a context item
  init [options]         Seed the global "agent-guidelines" prompt (a no-op if
                         it already exists)
  help [command]         display help for command
",
  "tines context create": "Usage: tines context create [options]

Create a context item scoped to a project, state, and/or issue

Options:
  -k, --kind <kind>             prompt, skill, or repo
  -n, --name <name>             item name (slug-like for skills; the
                                dedup/override key)
  -d, --description <text>      one-liner shown in lists
  --body <md>                   prompt body: inline Markdown or @file (escape a
                                literal @ as @@)
  --file <path>=@<local>        skill file: workspace path = local file
                                (repeatable) (default: [])
  --repo-url <url>              repo: clone URL
  --branch <branch>             repo: branch to check out
  --dir <dir>                   repo: checkout directory (defaults to the URL's
                                basename)
  -p, --project <name>          scope: project name or id
  -s, --state <workflow/state>  scope: workflow-qualified state
  -i, --issue <ref>             scope: issue (<project>/<number>)
  -l, --label <name>            scope: issue label name or id
  -u, --url <url>               base URL of the Tines API (or set TINES_API_URL,
                                or run \`tines login\`; default
                                https://tines.tbuckley.dev)
  --api-key <key>               API key (or set TINES_API_KEY, or run \`tines
                                login\`)
  --json                        output the raw JSON response
  -h, --help                    display help for command
",
  "tines context delete": "Usage: tines context delete [options] <id>

Delete a context item

Options:
  -u, --url <url>  base URL of the Tines API (or set TINES_API_URL, or run
                   \`tines login\`; default https://tines.tbuckley.dev)
  --api-key <key>  API key (or set TINES_API_KEY, or run \`tines login\`)
  --json           output the raw JSON response
  -h, --help       display help for command
",
  "tines context edit": "Usage: tines context edit [options] <id>

Edit a context item: payload, name, description, or scope

Options:
  -n, --name <name>             rename the item
  -d, --description <text>      set the description
  --body <md>                   prompt body: inline Markdown or @file (escape a
                                literal @ as @@)
  --file <path>=@<local>        add or replace a skill file (repeatable)
                                (default: [])
  --remove-file <path>          remove a skill file (repeatable) (default: [])
  --repo-url <url>              repo: clone URL
  --branch <branch>             repo: branch (empty string clears it)
  --dir <dir>                   repo: checkout directory (empty string restores
                                the URL default)
  --unset <dimension>           drop a scope dimension: project, state, issue,
                                or label (repeatable) (default: [])
  --expect-version <n>          fail (409) unless the item is still at this
                                version
  -p, --project <name>          scope: project name or id
  -s, --state <workflow/state>  scope: workflow-qualified state
  -i, --issue <ref>             scope: issue (<project>/<number>)
