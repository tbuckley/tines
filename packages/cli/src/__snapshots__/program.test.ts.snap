  --resume-enabled <true|false>  stage opt-in policy (enabling is unavailable
                                 until provider support ships)
  --resume-window-hours <n>      continuation window (1-168)
  --resume-max-turns <n>         local conversation turn limit (1-1000)
  --resume-max-tokens <n>        managed conversation token limit (1-10000000)
  --resume-max-cost-usd <n>      managed conversation cost limit (0-1000]
  -u, --url <url>                base URL of the Tines API (or set
