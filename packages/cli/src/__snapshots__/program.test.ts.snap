                           run \`tines login\`; default
                           https://tines.tbuckley.dev)
  --api-key <key>          API key (or set TINES_API_KEY, or run \`tines login\`)
  --json                   output the raw JSON response
  -h, --help               display help for command
",
  "tines workflows install": "Usage: tines workflows install [options] <file>

Install one exactly reviewed workflow package plan

Options:
  --choices <file>         destination choices JSON file (interactive
                           preparation only)
  --plan <file>            signed plan saved by workflows preview
  --confirm <plan-digest>  exact reviewed plan digest (required outside a TTY)
  -u, --url <url>          base URL of the Tines API (or set TINES_API_URL, or
                           run \`tines login\`; default
                           https://tines.tbuckley.dev)
  --api-key <key>          API key (or set TINES_API_KEY, or run \`tines login\`)
  --json                   output the raw JSON response
  -h, --help               display help for command
",
  "tines workflows list": "Usage: tines workflows list [options]

List the workflow library

Options:
  --limit <n>        maximum items to return (page size under --all-pages)
  --cursor <cursor>  resume from the next_cursor of a previous page
  --all-pages        fetch every page, not just the first (slower on large
                     lists)
  -u, --url <url>    base URL of the Tines API (or set TINES_API_URL, or run
                     \`tines login\`; default https://tines.tbuckley.dev)
  --api-key <key>    API key (or set TINES_API_KEY, or run \`tines login\`)
  --json             output the raw JSON response
  -h, --help         display help for command
",
  "tines workflows preview": "Usage: tines workflows preview [options] <file>

Prepare and fully review a destination workflow package plan

Options:
  --choices <file>   destination choices JSON file
  --plan-out <file>  atomically save the signed plan for a later install
  -u, --url <url>    base URL of the Tines API (or set TINES_API_URL, or run
                     \`tines login\`; default https://tines.tbuckley.dev)
  --api-key <key>    API key (or set TINES_API_KEY, or run \`tines login\`)
  --json             output the raw JSON response
  -h, --help         display help for command
",
